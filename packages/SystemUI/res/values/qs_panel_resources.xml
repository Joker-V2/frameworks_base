    <!-- QS panel header: room reserved above the first row of tiles -->
    <dimen name="qs_coloros_header_height">76dp</dimen>

    <!-- QS panel: shown in the media card slot while nothing is playing -->
    <string name="qs_coloros_no_media">Not playing</string>
    <!-- QS panel editor: title, hint and the label of the tiles that are not in use yet -->
    <string name="qs_coloros_edit_title">Edit</string>
    <string name="qs_coloros_edit_hint">Hold and drag to rearrange</string>
    <string name="qs_coloros_edit_more">More tiles</string>
</resources>
